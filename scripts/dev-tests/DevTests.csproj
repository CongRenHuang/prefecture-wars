<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pre-Unity test harness: compiles Game.Core + Game.Tests sources directly.
       Once the Unity project exists, Unity Test Runner uses the same files via asmdefs;
       this project remains as a fast CLI dev loop. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion> <!-- match Unity 6 C# language level -->
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Game.Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Game.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>

</Project>
